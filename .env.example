# Server and database
PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://validatecall:validatecall_local@localhost:5435/validatecall
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3002
RUN_SCHEDULERS=false

# Google OAuth web application: identity only, no Gmail access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback

# Web research: two search requests and one model request per research job.
DEEPINFRA_API_KEY=
DEEPINFRA_RESEARCH_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
BRAVE_SEARCH_API_KEY=
RESEARCH_DAILY_USER_LIMIT=20
RESEARCH_DAILY_GLOBAL_LIMIT=200

# Optional voice/calling
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=

# Optional existing Claude gateway for scripts/email personalization (not lead data)
CLAUDE_API_URL=
CLAUDE_API_KEY=

# Optional billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Optional transactional email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=ValidateCall <noreply@validatecall.com>
EMAIL_REPLY_TO=support@validatecall.com

{
  "name": "market-research-api",
  "version": "1.0.0",
  "description": "API backend server for Market Research AI",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "db:migrate": "node db/migrate.js",
    "start:production": "node db/migrate.js && node index.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "ipaddr.js": "^2.3.0",
    "libphonenumber-js": "^1.13.13",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.23.0",
    "resend": "^6.7.0",
    "robots-parser": "^3.0.1",
    "stripe": "^20.1.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jest": "^30.2.0",
    "standardwebhooks": "^1.0.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": "22.x"
  }
}
